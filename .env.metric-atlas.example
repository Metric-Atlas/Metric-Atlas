# Metric Atlas Local Node Runtime
METRIC_ATLAS_RUNTIME_HOST=127.0.0.1
METRIC_ATLAS_RUNTIME_PORT=8787

# GA4
METRIC_ATLAS_GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
# METRIC_ATLAS_GA4_SERVICE_ACCOUNT_JSON_BASE64=

# Live Analytics Health (C-003) — PROPERTY_ID + credential이 있으면 /api/health가 GA4를 실조회
METRIC_ATLAS_CACHE_TTL_SECONDS=300
METRIC_ATLAS_GA4_RECENT_WINDOW_HOURS=48
# Health 관측 기간: Property timezone 기준 최근 N일 (2차 Spike 후 재검토 가능)
METRIC_ATLAS_GA4_HEALTH_WINDOW_DAYS=30

# LLM
METRIC_ATLAS_LLM_PROVIDER=openai-compatible
METRIC_ATLAS_LLM_BASE_URL=
METRIC_ATLAS_LLM_API_KEY=
METRIC_ATLAS_LLM_MODEL=
METRIC_ATLAS_LLM_MAX_CANDIDATES=20
METRIC_ATLAS_LLM_TIMEOUT_MS=10000
