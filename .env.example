# Core
METRIC_ATLAS_ENABLED=true
METRIC_ATLAS_MODE=internal
METRIC_ATLAS_DASHBOARD_PATH=/event-dashboard
METRIC_ATLAS_PORT=4173
METRIC_ATLAS_CACHE_TTL_SECONDS=300

# Demo / temporary credential policy
METRIC_ATLAS_DEMO_MODE=false
METRIC_ATLAS_ALLOW_RUNTIME_CREDENTIAL_INPUT=false

# Runtime protection
METRIC_ATLAS_MAX_OUTBOUND_CONCURRENCY=4
METRIC_ATLAS_RATE_LIMIT_PER_MINUTE=60

# GA4
METRIC_ATLAS_GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
METRIC_ATLAS_GA4_SERVICE_ACCOUNT_JSON_BASE64=

# Recent-data warning policy; can be recalibrated after GA4 spike
METRIC_ATLAS_GA4_RECENT_WINDOW_HOURS=48

# Live Analytics Health observation window in property-timezone days (C-003)
METRIC_ATLAS_GA4_HEALTH_WINDOW_DAYS=30

# LLM
METRIC_ATLAS_LLM_PROVIDER=openai-compatible
METRIC_ATLAS_LLM_BASE_URL=
METRIC_ATLAS_LLM_API_KEY=
METRIC_ATLAS_LLM_MODEL=
METRIC_ATLAS_LLM_MAX_CANDIDATES=20
METRIC_ATLAS_LLM_TIMEOUT_MS=10000
METRIC_ATLAS_LLM_MAX_CONCURRENCY=2
